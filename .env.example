# Database connection
# SQLite (local dev — default, uses ../aurea77-api/database/database.sqlite)
# DATABASE_URL=sqlite:///path/to/database.sqlite
# MySQL (production)
# DATABASE_URL=mysql://user:password@host:3306/aurea77

# API key authentication (leave empty for open access in dev)
RECOMMENDER_API_KEY=

# Logging
LOG_FORMAT=text
LOG_LEVEL=INFO
